---
pagination: { data: site.languages, size: 1, alias: lang }
permalink: "{{ i18n[lang].feed }}"
eleventyExcludeFromCollections: true
---
{%- assign t = i18n[lang] -%}
{%- assign key = "posts_" | append: lang -%}
{%- assign posts = collections[key] -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ lang }}">
  <title>{{ t.site_title | xml_escape }}</title>
  <link href="{{ t.feed | absolute_url }}" rel="self"/>
  <link href="{{ t.home | absolute_url }}"/>
  <id>{{ t.home | absolute_url }}</id>
  <updated>{{ posts[0].date | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- for post in posts limit: 20 %}
  <entry>
    <title>{{ post.data.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary>{{ post | excerpt: 400 | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
